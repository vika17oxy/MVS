# Virtual environment (recreate with: pip install -r requirements.txt)
.venv/

# GTSRB dataset (recreate with: python download_data.py)
data/

# Trained models, ~250 MB (recreate with: python train.py)
models/

# Python cache
__pycache__/
*.pyc

# Local MVSR data, runs and model artifacts (existing GTSRB results stay tracked)
artifacts/
sample_dataset/
dataset/
heldout/
results/
*.joblib
*.pkl
*.npz
*.zip
.pytest_cache/
.coverage
htmlcov/
.env
.env.*
!.env.example
